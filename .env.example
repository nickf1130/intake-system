# Discord bot token
TOKEN=

# The Google Form URL that members fill out.
INTAKE_FORM_URL=

# The Sheet the form writes responses to. This is the long string in the
# sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
INTAKE_SHEET_ID=

# Category that new ticket channels are created in.
INTAKE_TICKET_CATEGORY_ID=

# Path to a Google service account JSON key. This is the recommended way to
# read the sheet. Share the sheet with the service account's email as Viewer.
# Optionally if unset, the bot looks for ./credentials.json or ./service_account.json.
GOOGLE_SERVICE_ACCOUNT_FILE=

# A fallback to read the sheet through Google's public CSV export instead of a
# service account. Leave disabled unless necessary.
INTAKE_ALLOW_PUBLIC_CSV=0

# Which tab to read. Leave INTAKE_SHEET_TAB blank to use the first tab.
INTAKE_SHEET_TAB=
INTAKE_SHEET_GID=0

# How often to check the sheet for new responses, in seconds (minimum 15).
INTAKE_POLL_SECONDS=60

# Safety valve: the most tickets the bot will create in a single check.
# Stops a mistake (or a restored backup) from flooding the server.
INTAKE_MAX_TICKETS_PER_POLL=5

# Keep this 0 unless you need to re-print all tickets in the log.
INTAKE_PROCESS_BACKLOG=0

# Discord allows a maximum of 50 channels per category. When the main ticket
# category is full the bot moves to these, in order. Comma-separated.
INTAKE_OVERFLOW_CATEGORY_IDS=

# Staff-only channel where a transcript is posted when a ticket is closed.
INTAKE_TRANSCRIPT_CHANNEL_ID=

# Delete the channel after a transcript has been saved. Set to 0 to keep
# closed channels around (locked and hidden) instead.
INTAKE_DELETE_ON_CLOSE=1

# Grace period between "ticket closed" and the channel disappearing, so
# staff can grab anything they still need.
INTAKE_DELETE_DELAY_SECONDS=60

# Managers. Anyone with one of these roles (or the Manage Server permission)
# can claim and close tickets and run the admin commands.
OPS_ROLE_ID=
COMP_ROLE_ID=

# Pinged when a submission names the president, VP, or treasurer.
SECRETARY_ROLE_ID=

# Retains access to a ticket channel after it has been closed.
CLOSE_ROLE_ID=

INTAKE_DEPARTMENT_FIELD=What branch do you require help from (operations/competitive)
INTAKE_USER_FIELD=Discord handle
INTAKE_DISCORD_ID_FIELD=Discord ID
INTAKE_COMP_SUPPORT_FIELD=What Competitive Team(s) do you need support from?
INTAKE_OPS_SUPPORT_FIELD=What Operations Teams do you need support from?
INTAKE_APPROVER_FIELD=Who would be most appropriate to help

# Words that route a submission to each branch, comma-separated.
INTAKE_OPS_KEYS=ops,operations
INTAKE_COMP_KEYS=comp,competitive
INTAKE_SECRETARY_KEYS=president,vp,treasurer

# Where the bot remembers which responses it has already handled. Deleting
# these files makes the bot repost recent tickets, so keep them safe.
STATE_DIR=./state
LOG_DIR=./logs
LOG_LEVEL=INFO

# Operations teams
OPS_TEAM_ROLE_BROADCASTING=
OPS_TEAM_USERS_BROADCASTING=
OPS_TEAM_ROLE_EVENT_PLANNING=
OPS_TEAM_USERS_EVENT_PLANNING=
